root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# Composables are named like types (HomeScreen), which ktlint's function
# naming rule would otherwise reject.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json,md,toml}]
indent_size = 2
